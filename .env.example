# ============================================================
# 大模型 API 配置（OpenAI 兼容接口，三选一即可）
# ============================================================

# ---- 方案 A：DeepSeek（推荐，性价比最高，新用户送 500 万 token）----
# 注册地址：https://platform.deepseek.com/
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_MODEL=deepseek-chat

# ---- 方案 B：硅基流动 SiliconFlow（有免费模型，零成本学习）----
# 注册地址：https://cloud.siliconflow.cn/
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_API_KEY=sk-your-siliconflow-key-here
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---- 方案 C：OpenAI 官方 ----
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-key-here
# LLM_MODEL=gpt-4o-mini

# ---- 可选：备用模型（用于模型路由演示，简单问题用便宜模型）----
LLM_MODEL_FAST=deepseek-chat
LLM_MODEL_SMART=deepseek-reasoner

# ---- 服务配置 ----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
